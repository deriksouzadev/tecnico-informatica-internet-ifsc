programa {
  funcao inicio() 
  
  {
    inteiro valor1
    inteiro valor2

     escreva("Digite o primeiro valor: ")
     leia(valor1)

     escreva("Digite o segundo valor: ")
     leia(valor2)

     se(valor1>valor2)
     {
      escreva("O primeiro número é maior")
      
     }
     
    senao

    {
      escreva("O segundo número é maior")
    }
  
    
  }
}
